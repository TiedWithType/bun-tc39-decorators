@@ -0,0 +1,72 @@
+import { describe, expect, test } from "bun:test";
+import { chmodSync, existsSync, lstatSync, realpathSync, statSync, symlinkSync } from "node:fs";
+import { join } from "node:path";
+import { bunEnv, bunExe, isAndroid, tempDir } from "harness";
+
+// Android app seccomp sends SIGSYS for openat2/fchmodat2. All fixtures are
+// local so the tests also run offline in a private Termux directory.
+describe.skipIf(!isAndroid)("Termux package bins", () => {
+  for (const backend of ["default", "copyfile"]) {
+    test(`installs and chmods a nested bin with ${backend}`, () => {
+      using dir = tempDir("termux-nested-bin", {
+        "bunfig.toml": '[install]\nlinker = "hoisted"\n',
+        "package.json": JSON.stringify({ workspaces: ["packages/*"] }),
+        "packages/tool/package.json": JSON.stringify({
+          name: "termux-tool",
+          version: "1.0.0",
+          bin: { "termux-tool": "bin/cli.js" },
+        }),
+        "packages/tool/bin/cli.js": '#!/usr/bin/env node\nconsole.log("termux-bin-ok");\n',
+      });
+      const root = String(dir);
+      const target = join(root, "packages/tool/bin/cli.js");
+      chmodSync(target, 0o600);
+      const result = Bun.spawnSync({
+        cmd: [bunExe(), "install", "--ignore-scripts", ...(backend === "copyfile" ? ["--backend=copyfile"] : [])],
+        cwd: root,
+        env: bunEnv,
+        stdout: "pipe",
+        stderr: "pipe",
+        timeout: 15000,
+      });
+      expect(result.exitCode).toBe(0);
+      const link = join(root, "node_modules/.bin/termux-tool");
+      expect(lstatSync(link).isSymbolicLink()).toBe(true);
+      expect(realpathSync(link)).toBe(realpathSync(target));
+      expect(statSync(target).mode & 0o100).toBe(0o100);
+    });
+  }
+
+  for (const parentSymlink of [false, true]) {
+    test(`preserves bin symlink protection (${parentSymlink ? "parent" : "final"})`, () => {
+      using dir = tempDir("termux-bin-containment", {
+        "bunfig.toml": '[install]\nlinker = "hoisted"\n',
+        "package.json": JSON.stringify({ workspaces: ["packages/*"] }),
+        "packages/tool/package.json": JSON.stringify({
+          name: "termux-tool",
+          version: "1.0.0",
+          bin: { "termux-tool": parentSymlink ? "linked/victim.js" : "payload" },
+        }),
+        "outside/victim.js": "do not make me executable",
+      });
+      const root = realpathSync(String(dir));
+      const victim = join(root, "outside/victim.js");
+      chmodSync(victim, 0o600);
+      symlinkSync(
+        parentSymlink ? join(root, "outside") : victim,
+        join(root, "packages/tool", parentSymlink ? "linked" : "payload"),
+      );
+      const result = Bun.spawnSync({
+        cmd: [bunExe(), "install", "--ignore-scripts"],
+        cwd: root,
+        env: bunEnv,
+        stdout: "pipe",
+        stderr: "pipe",
+        timeout: 15000,
+      });
+      expect(result.exitCode).toBe(0);
+      expect(statSync(victim).mode & 0o777).toBe(0o600);
+      expect(existsSync(join(root, "node_modules/.bin/termux-tool"))).toBe(!parentSymlink);
+    });
+  }
+});
