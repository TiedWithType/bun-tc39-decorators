+
+
+function hasOpaqueAndroidStorageAncestor(): boolean {
+  if (!isAndroid || !existsSync("/storage/emulated/0")) return false;
+  try {
+    closeSync(openSync("/storage/emulated/", "r"));
+    return false;
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === "ENOENT";
+  }
+}
+
+// Other platforms and Android mounts without the hidden ancestor cannot reproduce this.
+test.skipIf(!hasOpaqueAndroidStorageAncestor())(
+  "package scripts run beneath opaque Android shared-storage ancestors",
+  async () => {
+    const previousTmpdir = process.env.TMPDIR;
+    let fixture: ReturnType<typeof tempDir>;
+    try {
+      process.env.TMPDIR = "/storage/emulated/0";
+      fixture = tempDir("bun-run-shared-storage", {
+        "package.json": JSON.stringify({ scripts: { opaque: "bun script.ts" } }),
+        "script.ts": 'console.log("shared-storage-ok");',
+      });
+    } finally {
+      if (previousTmpdir === undefined) delete process.env.TMPDIR;
+      else process.env.TMPDIR = previousTmpdir;
+    }
+    using dir = fixture;
+    expect(String(dir).startsWith("/storage/emulated/0/")).toBe(true);
+    await using direct = Bun.spawn({
+      cmd: [bunExe(), "script.ts"],
+      cwd: String(dir),
+      env: bunEnv,
+      stdout: "pipe",
+      stderr: "pipe",
+    });
+    const [directStdout, directStderr, directExitCode] = await Promise.all([
+      direct.stdout.text(), direct.stderr.text(), direct.exited,
+    ]);
+    expect(directStdout).toBe("shared-storage-ok\n");
+    expect(directStderr).toBe("");
+    expect(directExitCode).toBe(0);
+    for (const args of [["run", "opaque"], ["opaque"]]) {
+      await using proc = Bun.spawn({
+        cmd: [bunExe(), ...args],
+        cwd: String(dir),
+        env: bunEnv,
+        stdout: "pipe",
+        stderr: "pipe",
+      });
+      const [stdout, stderr, exitCode] = await Promise.all([
+        proc.stdout.text(), proc.stderr.text(), proc.exited,
+      ]);
+      expect(stdout).toBe("shared-storage-ok\n");
+      expect(stderr).toBe("$ bun script.ts\n");
+      expect(exitCode).toBe(0);
+    }
+  },
+);
